# Copia este archivo a .env para desarrollo local. Nunca subas .env al repo.

# Solo para el modo stdio (local). En modo HTTP la key llega en cada request
# desde el cliente MCP y no se configura aquí.
PAYG0_API_KEY=pyg0_test_tu_key_aqui

# Transporte: "streamable-http" (por defecto) o "stdio"
MCP_TRANSPORT=streamable-http

# Producción: hosts permitidos en el header Host, separados por coma.
# MCP_ALLOWED_HOSTS=mcp.payg0.io

# URL del API de Payg0 (por defecto https://api.payg0.io)
# PAYG0_API_URL=https://api.payg0.io
