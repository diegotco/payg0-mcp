# Copy this file to .env for local development. Never commit .env.

# Only for stdio mode (local). In HTTP mode the key arrives with every request
# from the MCP client and is not configured here.
PAYG0_API_KEY=pyg0_test_your_key_here

# Transport: "streamable-http" (default) or "stdio"
MCP_TRANSPORT=streamable-http

# Production: hosts allowed in the Host header, comma-separated.
# MCP_ALLOWED_HOSTS=mcp.payg0.io

# Payg0 API URL (defaults to https://api.payg0.io)
# PAYG0_API_URL=https://api.payg0.io
